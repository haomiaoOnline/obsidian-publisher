{
  "name": "obsidian-publisher",
  "version": "0.5.0",
  "description": "Publish an Obsidian note to multiple platform drafts through replaceable adapters.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:x-bridge": "node scripts/validate-x-bridge.mjs",
    "test:watch": "vitest"
  },
  "keywords": [
    "obsidian",
    "publisher",
    "wechat",
    "xiaohongshu",
    "x-articles",
    "wechatsync"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.7.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
